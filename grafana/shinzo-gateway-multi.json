{
  "uid": "shinzo-gateway-multi",
  "title": "Shinzo Gateway - multi",
  "description": "Shinzo network gateway fleet: compare replicas and spot the one that diverges.",
  "tags": [
    "shinzo",
    "gateway",
    "multi"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Shinzo",
      "tags": [
        "shinzo"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/grafanacloud-.*-prom/"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(shinzo_gateway_hosts_known, job)",
        "query": {
          "query": "label_values(shinzo_gateway_hosts_known, job)",
          "refId": "job"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(shinzo_gateway_hosts_known{job=~\"$job\"}, instance)",
        "query": {
          "query": "label_values(shinzo_gateway_hosts_known{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Fleet",
      "description": "One row per gateway replica, unhealthy first. Failure ratio = no_hosts, upstream_error and error requests over all requests. Divergent = share of compared responses without full consensus. Known hosts, routable hosts and collections should match across replicas; a replica that differs has a stale view of the hosts. Click an instance to open its single dashboard.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (instance, service_version) (target_info{job=~\"$job\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "min by (instance) (\n  label_replace(max by (instance) (shinzo_gateway_hosts_routable{job=~\"$job\", instance=~\"$instance\"}) > bool 0, \"check\", \"hosts\", \"\", \"\")\n  or label_replace(max by (instance) (shinzo_gateway_collections{job=~\"$job\", instance=~\"$instance\"}) > bool 0, \"check\", \"collections\", \"\", \"\")\n  or label_replace((sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\", result=~\"upstream_error|no_hosts\"}[10m])) or 0 * sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[10m]))) / (sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[10m])) > 0) < bool 0.5, \"check\", \"requests\", \"\", \"\")\n)",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (resets(process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "(\n  sum by (instance) (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\", result=~\"no_hosts|upstream_error|error\"}[$__rate_interval])) or 0 * sum by (instance) (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))\n)\n/\n(\n  sum by (instance) (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))\n)",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(shinzo_gateway_request_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\", result=\"success\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (rate(shinzo_gateway_upstream_errors_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "(\n  sum by (instance) (rate(shinzo_gateway_consensus_total{job=~\"$job\", instance=~\"$instance\", consensus!=\"full\"}[$__rate_interval])) or 0 * sum by (instance) (rate(shinzo_gateway_consensus_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))\n)\n/\n(\n  sum by (instance) (rate(shinzo_gateway_consensus_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))\n)",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_gateway_hosts_known{job=~\"$job\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_gateway_hosts_routable{job=~\"$job\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_gateway_collections{job=~\"$job\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "L",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "instance": 0,
              "service_version": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12
            },
            "renameByName": {
              "Value #B": "Health",
              "Value #C": "Uptime",
              "Value #D": "Restarts",
              "Value #E": "Req/min",
              "Value #F": "Failure ratio",
              "Value #G": "Request p95",
              "Value #H": "Upstream err/min",
              "Value #I": "Divergent",
              "Value #J": "Known hosts",
              "Value #K": "Routable",
              "Value #L": "Collections",
              "service_version": "Version"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.instance} in Shinzo Gateway - single",
                    "url": "/d/shinzo-gateway-single?var-job=${job}&var-instance=${__data.fields.instance}&${datasource:queryparam}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unhealthy",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Healthy",
                        "color": "green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Down",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "noValue",
                "value": "Down"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Req/min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failure ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Request p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upstream err/min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.001
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Divergent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Known hosts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Routable"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Collections"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Health",
            "desc": false
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 2,
      "title": "Fleet totals",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Replicas up",
      "description": "Replicas reporting process.uptime.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count (max by (instance) (process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Healthy replicas",
      "description": "Replicas passing the health check (see the Health column).",
      "gridPos": {
        "x": 4,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum (min by (instance) (\n  label_replace(max by (instance) (shinzo_gateway_hosts_routable{job=~\"$job\", instance=~\"$instance\"}) > bool 0, \"check\", \"hosts\", \"\", \"\")\n  or label_replace(max by (instance) (shinzo_gateway_collections{job=~\"$job\", instance=~\"$instance\"}) > bool 0, \"check\", \"collections\", \"\", \"\")\n  or label_replace((sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\", result=~\"upstream_error|no_hosts\"}[10m])) or 0 * sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[10m]))) / (sum by (instance) (increase(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[10m])) > 0) < bool 0.5, \"check\", \"requests\", \"\", \"\")\n)) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Requests",
      "description": "GraphQL requests per minute, summed over the fleet.",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Failure ratio",
      "description": "Fleet share of no_hosts, upstream_error and error requests.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "(\n  sum (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\", result=~\"no_hosts|upstream_error|error\"}[$__rate_interval])) or vector(0)\n)\n/\n(\n  sum (rate(shinzo_gateway_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))\n)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Request p95",
      "description": "Fleet-wide 95th percentile of successful request duration.",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
